extends TextureRect

var audio1
var audio2

var canClick = true
var bullets = 6

func _ready():
	Input.mouse_mode = Input.MOUSE_MODE_HIDDEN
	audio1 = $shootingSFX
	audio2 = $reloadingSFX

func _process(delta):
	if Input.is_action_just_pressed("click") and canClick == true and bullets > 0:
		print("click")
		canClick = false
		bullets -= 1
		audio1.play()
		rotation_degrees -= 30
		
		await get_tree().create_timer(0.1).timeout
		rotation_degrees += 30
		
		await get_tree().create_timer(0.2).timeout
		canClick = true
	elif Input.is_action_just_pressed("click") and canClick == true and bullets <= 0:
		canClick = false
		print("reloading")
		rotation_degrees += 40
		position.y += 200
		position.x += 100
		
		audio2.play()
		await get_tree().create_timer(2.6).timeout
		rotation_degrees -= 40
		position.y -= 200
		position.x -= 100
		bullets = 6
		canClick = true
